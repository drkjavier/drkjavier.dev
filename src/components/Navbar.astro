---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: 'es' | 'en';
  translations: Record<string, any>;
}

const { lang, translations } = Astro.props;
const nav = translations.navigation;

// Selector de tema: SOLO en desarrollo (en producción no se emite).
const showThemeToggle = import.meta.env.DEV;

const links = [
  { href: '#about', label: nav.about[lang] },
  { href: '#skills', label: nav.skills[lang] },
  { href: '#experience', label: nav.experience[lang] },
  { href: '#projects', label: nav.projects[lang] },
  { href: '#education', label: nav.education[lang] },
  { href: '#contact', label: nav.contact[lang] },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm border-b border-border">
  <div class="container-main flex items-center justify-between px-4 md:px-8 h-16">
    <a href="/" class="text-xl font-bold" style={`color: var(--color-primary)`}>
      drkjavier<span style={`color: var(--color-accent)`}>.dev</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium transition-colors hover:text-accent"
          style={`color: var(--color-text-muted)`}
        >
          {link.label}
        </a>
      ))}
      {showThemeToggle && <ThemeToggle />}
      <slot name="toggle" />
    </div>

    <!-- Mobile menu button -->
    <div class="md:hidden flex items-center gap-3">
      <slot name="toggle" />
      <button id="mobile-menu-btn" class="p-2" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-border bg-background">
    <div class="px-4 py-4 flex flex-col gap-3">
      {showThemeToggle && (
        <div class="py-2">
          <ThemeToggle />
        </div>
      )}
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium py-2"
          style={`color: var(--color-text-muted)`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<!-- Spacer for fixed navbar -->
<div class="h-16" />

<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
  // Close mobile menu on link click
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.add('hidden');
    });
  });
</script>
