---
interface Props {
  projects: Record<string, any>;
  translations: Record<string, any>;
  lang: 'es' | 'en';
}

const { projects, translations, lang } = Astro.props;
---

<section id="projects" class="section" style={`background-color: var(--color-surface)`}>
  <div class="container-main">
    <h2 class="section-title">{translations.projects.title[lang]}</h2>

    <div class="grid grid-cols-1 gap-8 max-w-3xl mx-auto">
      {projects.projects.map((project: any) => (
        <div class="card">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
            <div>
              <h3 class="text-xl font-bold" style={`color: var(--color-primary)`}>{project.name}</h3>
              <p class="text-sm font-medium" style={`color: var(--color-accent)`}>
                {project.company} — {project.period}
              </p>
            </div>
          </div>

          <p class="mb-4" style={`color: var(--color-text-muted)`}>
            {project.description[lang]}
          </p>

          <h4 class="text-sm font-semibold mb-3" style={`color: var(--color-text)`}>
            {lang === 'es' ? '🏆 Logros destacados' : '🏆 Key achievements'}
          </h4>
          <ul class="space-y-2 mb-4">
            {project.highlights.map((highlight: any) => (
              <li class="flex items-start gap-2 text-sm" style={`color: var(--color-text-muted)`}>
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: var(--color-accent)`}></span>
                {highlight[lang]}
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2 pt-3 border-t" style={`border-color: var(--color-border)`}>
            {project.technologies.map((tech: string) => (
              <span class="badge-tech">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
