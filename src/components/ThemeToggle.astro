---
/**
 * Selector de tema — ⚠️ SOLO DESARROLLO.
 * Navbar lo renderiza únicamente bajo `import.meta.env.DEV`
 * (en producción no existe el botón y manda el valor definido
 * en `data-theme` de Layout.astro).
 * Cambia `html[data-theme]` en vivo y persiste en localStorage
 * (clave `theme`, solo leída en dev por Layout.astro).
 */
const themes = [
  { id: 'terminal', label: 'Terminal' },
  { id: 'aurora', label: 'Aurora' },
];
---

<div class="theme-toggle" role="group" aria-label="Tema del sitio (solo desarrollo)">
  {themes.map((theme) => (
    <button
      type="button"
      data-theme-id={theme.id}
      class="theme-btn"
      aria-pressed="false"
      title={`Tema ${theme.label} — solo visible en desarrollo`}
    >
      {theme.label}
    </button>
  ))}
</div>

<script>
  const sync = () => {
    const current = document.documentElement.getAttribute('data-theme');
    document.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeId === current));
    });
  };

  const apply = (id: string) => {
    document.documentElement.setAttribute('data-theme', id);
    try {
      localStorage.setItem('theme', id);
    } catch {
      /* modo privado: solo aplica en vivo */
    }
    sync();
  };

  sync();
  document.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.themeId ?? 'terminal'));
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .theme-btn {
    padding: 0.375rem 0.625rem;
    background: transparent;
    color: var(--color-text-muted);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .theme-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-alt);
  }

  .theme-btn[aria-pressed='true'] {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .theme-btn[aria-pressed='true']:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
</style>
